# ─────────────────────────────────────────────────────
#   SatyaCheck — Backend Environment Variables
#   Copy this file → rename to .env → done!
# ─────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# Ollama (Local AI) — install from https://ollama.com/download
# Then run: ollama pull llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:1b

# Database (OPTIONAL — remove # to enable PostgreSQL)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/satyacheck
