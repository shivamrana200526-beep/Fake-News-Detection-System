# Server Configuration
# PORT: Port for the backend API server (defaults to 3000 if not specified)
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL - Neon, Supabase, or local instance)
DATABASE_URL=postgresql://postgres:password@localhost:5432/satyacheck

# AI Providers & Model API Keys
# Google Gemini API Key (used for all AI features)
GEMINI_API_KEY=your_gemini_api_key_here
