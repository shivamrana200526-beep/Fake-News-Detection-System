# Server Configuration
# PORT: Port for the backend API server (defaults to 3000 if not specified)
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL - Neon, Supabase, or local instance)
DATABASE_URL=postgresql://postgres:password@localhost:5432/satyacheck

# AI Providers & Model API Keys
# OpenAI API Key (used for GPT-5.2 primary analysis, claims extraction, quiz & trending)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (used for Gemini 2.5 Flash secondary verification & image analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (used for Claude Sonnet 4.6 chat synthesis & streaming response)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
