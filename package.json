{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"green,blue\" \"npm run dev:backend\" \"npm run dev:frontend\",
    "dev:backend": "node --env-file=.env artifacts/api-server/src/index.js",
    "dev:frontend": "cd frontend-js && npm run dev",
    "start": "node --env-file=.env artifacts/api-server/src/index.js",
    "build": "pnpm -r --if-present run build"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.8.1"
  }
}
