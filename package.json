{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"green,blue\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --env-file=.env artifacts/api-server/src/index.js",
    "dev:frontend": "cd frontend-js && npm run dev",
    "start": "node --env-file=.env artifacts/api-server/src/index.js",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix artifacts/api-server run build",
    "build:frontend": "npm --prefix frontend-js run build"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.8.1"
  }
}
